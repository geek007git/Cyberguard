# Set these in the backend process environment. No secrets belong in frontend code.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Optional shared access token. Leave empty for loopback-only personal use.
CYBERGUARD_TOKEN=
# Optional database location; defaults to backend/cyberguard.sqlite3
# CYBERGUARD_DB=
# Comma-separated trusted frontend origins for state-changing requests
CYBERGUARD_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
